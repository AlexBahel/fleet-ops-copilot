# kind cluster configuration for `make demo` (hack/demo-up.sh renders it:
# @PEOPLE_DIR@ becomes the absolute path of the directory that holds
# tokens.csv, made by hack/kind-people.sh gen).
#
# TEST ONLY (ruling R43). It turns on the API server's static token file so
# that the fictional people sam, dana and eve authenticate with bearer tokens,
# and so can be verified requesters (D57) in the live tests. A static token
# file is not an identity system: no expiry, no rotation, readable by anyone
# who can read the file or the node's /etc/fleetops-people. Never use it on a
# cluster that holds anything real. In production the people authenticate
# with OIDC (docs/RUNBOOK.md, "People and bearer tokens: kind and OIDC").
#
# The patch names no kubeadm apiVersion on purpose: kind v0.33 applies it to
# kubeadm v1beta3 (Kubernetes before 1.36) and v1beta4, converting the
# extraArgs map for v1beta4 and keeping the arguments kind sets itself.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    extraMounts:
      - hostPath: @PEOPLE_DIR@
        containerPath: /etc/fleetops-people
        readOnly: true
kubeadmConfigPatches:
  - |
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        token-auth-file: /etc/fleetops-people/tokens.csv
      extraVolumes:
        - name: fleetops-people
          hostPath: /etc/fleetops-people
          mountPath: /etc/fleetops-people
          readOnly: true
          pathType: Directory
