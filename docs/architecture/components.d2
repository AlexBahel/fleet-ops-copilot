# Fleet Ops Copilot: processes, ServiceAccounts, model profiles, Swarmada webhooks.
# Source for components.svg; render with `d2 --layout elk components.d2 components.svg`
# (see README.md in this directory). Solid boxes are built; dashed boxes are
# designed (docs/DESIGN.md) but not built, or built but off by default.

direction: down

classes: {
  built: {style: {stroke: "#2b5797"; stroke-width: 2; border-radius: 6}}
  planned: {style: {stroke: "#7a7a7a"; stroke-dash: 5; border-radius: 6; font-color: "#555555"}}
  person: {shape: person}
  external: {style: {stroke: "#7a7a7a"; fill: "#f4f4f4"}}
}

legend: "Legend\nsolid box: built\ndashed box: not built, or off by default\nSA = ServiceAccount" {
  near: top-right
  style: {font-size: 14}
}

people: People {
  operator: Operator {class: person}
  approver: "Approver\n(named person)" {class: person}
}

claude_api: "Claude API\n(cloud profile)" {class: external}
otel: "OTLP collector\n(optional: tracing.otlpEndpoint)" {class: external}

cluster: Kubernetes cluster {
  foc: "namespace foc-system (Helm chart fleet-ops-copilot)" {
    agent: "foc-agent (model loop, web UI)\nSA foc-agent: get/list ApprovalRequest only\nweb chat + requests panel: shows foc approve/reject,\ncannot decide; ClusterIP, no Ingress, no login\nbackend: claude, llamacpp or scripted\n(roles Router ... Reporter: not built)" {class: built}
    mcp: "foc-mcp (MCP server)\nSA foc-mcp: get/list/watch Swarmada,\ncreate ApprovalRequest; no Swarmada write\npolicy engine, audit JSONL" {class: built}
    approvals: "foc-approvals (controller, executor)\nSA foc-approvals: create draft FleetTask,\ncreate ZoneMaintenance, patch + estop-trigger FleetZone\nSubjectAccessReview, policy re-check, audit JSONL" {class: built}
    policy: "ConfigMap fleetops-policy\n(policies/default.yaml)" {class: built}
    netpol: "NetworkPolicy (networkPolicy.enabled, off by default)\ndefault deny; DNS; API server ipBlock (incl. foc-agent);\nfoc-agent -> foc-mcp; foc-agent -> Claude API ipBlock;\nOTLP egress if given; no ingress to the web UI" {class: planned}

    airgap: "Air-gapped profile (config/airgap, not in chart)" {
      class: built
      llama: "llama-server (llama.cpp)\nQwen2.5-7B-Instruct GGUF\n--offline, model from PVC" {class: built}
      egress: "Egress NetworkPolicy\nDNS; API server for copilot pods;\nllama-server: no egress" {class: built}
    }

    agent -> mcp: "MCP over HTTP"
    agent -> airgap.llama: "chat completions (airgap profile;\n-backend llamacpp, not set by any manifest)" {style.stroke-dash: 5}
    policy -> mcp: mounted {style.stroke-dash: 2}
    policy -> approvals: mounted {style.stroke-dash: 2}
  }

  apiserver: "Kubernetes API server" {
    vap: "Copilot ValidatingAdmissionPolicies\nfleetops-requests: requestedBy = caller\nfleetops-decisions: person only, decidedBy = caller, immutable\nfleetops-foc-approvals-drafts-only\nfleetops-foc-approvals-zone-stop-only" {class: built}
    crds: "CRDs\nswarmada.io/v1 (Swarmada)\nApprovalRequest, ApprovalDecision\n(fleetops.alexbahel.github.io/v1alpha1)"
  }

  swarmada: "namespace system (Swarmada v0.4)" {
    manager: "swarmada-controller-manager\ncontrollers + webhook server" {class: external}
    webhooks: "Swarmada admission webhooks\nvfleettask: activate verb, refused to every SA\nvfleetzone: estop-trigger / estop-clear SubjectAccessReview\nvzonemaintenance: zone exists\nmfleetzone: stamps estop-actor, adds finalizer\n\nOff in the quickstart (quickstart-mtls overlay);\non with config/controlstream-tls (cert-manager).\nWithout vfleettask the copilot refuses drafts\n(DENY_DRAFT_GATE_ABSENT)." {class: external}
    manager -> webhooks: serves
  }

  foc.mcp -> apiserver: "read Swarmada;\ncreate ApprovalRequest"
  foc.agent -> apiserver: "get/list ApprovalRequest\n(requests panel)"
  foc.approvals -> apiserver: "watch ApprovalDecision;\nexecute approved writes"
  apiserver -> swarmada.webhooks: "admission calls\nfor swarmada.io writes"
}

people.operator -> cluster.foc.agent: "web chat (kubectl port-forward);\nrequester recorded as unverified:<name>,\nnever approvable (R38)"
cluster.foc.agent -> claude_api: "Messages API (cloud profile)\nkey from an existing Secret"
cluster.foc.agent -> otel: "traces (OTLP/gRPC)" {style.stroke-dash: 5}
cluster.foc.mcp -> otel: "traces: tool calls,\npolicy decisions" {style.stroke-dash: 5}
people.approver -> cluster.apiserver: "foc approve or foc reject:\nApprovalDecision with own credentials;\nruns the activation command itself"
