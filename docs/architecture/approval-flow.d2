# Fleet Ops Copilot: the life of a request, main steps. Source for approval-flow.svg;
# render with `d2 approval-flow.d2 approval-flow.svg` (see README.md in this directory).
# The full step list, with every check and refusal code: docs/design/approvals.md.
# Shown for a draft FleetTask. A zone maintenance window or a zone stop follows steps
# 1-8 with a different write in step 8 and has no activation. Step 10 is run by any
# person Swarmada allows to activate, with their own credentials (D79).

shape: sequence_diagram

operator: Operator {shape: person}
agent: fleetops-agent
mcp: fleetops-mcp
api: "Kubernetes API server"
approvals: fleetops-approvals
approver: "Approver" {shape: person}

request: "Request" {
  operator -> agent: "1. asks for work"
  agent -> operator: "2. at most two questions, then a preview"
  operator -> agent: "3. confirms the preview"
  agent -> mcp: "4. files the confirmed preview"
  mcp -> api: "5. policy check; creates ApprovalRequest"
}

decide: "Decision" {
  approver -> api: "6. fleetops approve, own credentials"
  approvals -> api: "7. checks the decision, re-runs the policy"
}

execute: "Execution" {
  approvals -> api: "8. re-checks, dry run, creates held draft"
}

activate: "Activation" {
  operator -> agent: "9. asks to activate: steps 1-7 again"
  approver -> api: "10. fleetops activate, own credentials"
  approvals -> api: "11. records who activated, then the outcome"
}
